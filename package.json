{
  "name": "music-memory-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:patch-podfile": "node -e \"const fs=require('fs'),f='ios/Podfile',c=fs.readFileSync(f,'utf8');if(!c.includes(\\\"project 'Soundtracks'\\\"))fs.writeFileSync(f,\\\"project 'Soundtracks'\\\\n\\\\n\\\"+c)\"",
    "ios:clean": "expo prebuild --clean && npm run ios:patch-podfile && rm -rf ios/Tracks.xcodeproj && cd ios && pod install --repo-update && cd .. && expo run:ios --device",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "lint": "eslint . --max-warnings 65",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/config-plugins": "~58.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@lomray/react-native-apple-music": "^1.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.100.10",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.12",
    "expo-auth-session": "~58.0.18",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-share-intent": "^9.0.0",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "patch-package": "^8.0.1",
    "posthog-react-native": "^4.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
