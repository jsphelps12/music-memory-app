# Copy to .env and fill in. Local development points at STAGING, not production.
#
# EXPO_PUBLIC_APP_ENV=preview makes app.config.ts build the beta identity:
# "Soundtracks β", bundle com.joshuaphelps.musicmemory.preview, scheme
# soundtracks-beta://. Leave it out and `expo run:ios` builds the PRODUCTION
# bundle id — the same one as the App Store app, so a device build replaces it,
# and every local read and write hits the production database.
#
# The Supabase values below must be the STAGING project. Get the current pair
# with `npx eas-cli env:list --environment preview`.
EXPO_PUBLIC_APP_ENV=preview
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here

EXPO_PUBLIC_SENTRY_DSN=https://your-key@ingest.us.sentry.io/your-project-id
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_revenuecat_ios_api_key
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_posthog_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
